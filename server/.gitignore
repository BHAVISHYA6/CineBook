# ── Node & npm ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment secrets (NEVER commit real credentials) ──────────────────────
.env
.env.local
.env.production

# ── Prisma generated client (regenerated by `prisma generate`) ───────────────
# Keep schema.prisma and migrations, but not the generated binary client
# node_modules/@prisma/client is covered above

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/

# ── Test coverage reports ─────────────────────────────────────────────────────
coverage/

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
