# ─────────────────────────────────────────────────────────────────────────────
# CineBook Server – Environment Variable Reference
# Copy this file to .env and fill in REAL values for local development.
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express HTTP server listens on.
PORT=5000

# Runtime environment: development | test | production
NODE_ENV=development

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Full Prisma connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Change <user>, <password>, and <dbname> for your local Postgres installation.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinebook_db?schema=public"

# ── JWT Authentication ────────────────────────────────────────────────────────
# A long, random, secret string used to sign and verify JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret_string"

# How long JWT tokens remain valid. Examples: 7d, 24h, 60m
JWT_EXPIRES_IN="7d"

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of the React client, used as the CORS allowed origin.
CLIENT_URL="http://localhost:5173"

# ── Future: Redis (Phase 2) ───────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ── Future: Razorpay (Phase 3) ────────────────────────────────────────────────
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
